# URL страницы мониторинга метеостанций
MONITOR_URL=

# Учётные данные для авторизации
MONITOR_LOGIN=
MONITOR_PASSWORD=

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# ID канала (опционально; сообщения в канал только при /check или /status в чате канала)
TELEGRAM_CHANNEL_ID=

# Список ID администраторов (через запятую). Только они могут использовать /check и /status.
# Если не задано — команды доступны всем.
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Ссылки на сообщения для редактирования вместо отправки нового.
# Можно указать несколько ссылок через запятую или перенос строки.
# Форматы: https://t.me/c/1234567890/123 | t.me/username/123 | -1001234567890:123
# Если задано — бот будет обновлять эти сообщения при каждой публикации
# Пример нескольких сообщений:
# MESSAGE_TO_EDIT=https://t.me/c/123/456,https://t.me/c/789/012
MESSAGE_TO_EDIT=

# Частота обновления «📊 Текущее состояние погоды» (в секундах)
UPDATE_INTERVAL_SECONDS=60

# Использовать Playwright для JS-страниц (true/false). Нужен для загрузки динамических данных.
USE_PLAYWRIGHT=true

# Кеширование: директория и TTL (в секундах)
# Обращение к сайту происходит не чаще чем CACHE_TTL секунд
CACHE_DIR=./cache
CACHE_TTL=300

# Часовой пояс для отображения времени (Europe/Moscow, Europe/London, UTC и т.д.)
TIMEZONE=Europe/Moscow
