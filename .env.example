# URL страницы мониторинга метеостанций
MONITOR_URL=

# Учётные данные для авторизации
MONITOR_LOGIN=
MONITOR_PASSWORD=

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# ID канала для отправки (например @channel_name или -1001234567890)
TELEGRAM_CHANNEL_ID=

# Ссылка на сообщение для редактирования вместо отправки нового.
# Форматы: https://t.me/c/1234567890/123 | t.me/username/123 | -1001234567890:123
# Если задано — бот будет обновлять это сообщение при каждой публикации, а не создавать новое
MESSAGE_TO_EDIT=

# Частота обновления «📊 Текущее состояние погоды» (в секундах)
UPDATE_INTERVAL_SECONDS=60

# Использовать Playwright для JS-страниц (true/false). Нужен для загрузки динамических данных.
USE_PLAYWRIGHT=true

# Кеширование: директория и TTL (в секундах)
# Обращение к сайту происходит не чаще чем CACHE_TTL секунд
CACHE_DIR=./cache
CACHE_TTL=300

# Часовой пояс для отображения времени (Europe/Moscow, Europe/London, UTC и т.д.)
TIMEZONE=Europe/Moscow
